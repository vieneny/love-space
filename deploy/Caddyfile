{$PUBLIC_DOMAIN} {
    encode zstd gzip
    handle /api/v1/app/media {
        request_body {
            max_size 12MB
        }
        reverse_proxy api:18100
    }
    handle /api/* {
        request_body {
            max_size 256KB
        }
        reverse_proxy api:18100
    }
    handle /health {
        reverse_proxy api:18100
    }
    handle {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }
}
