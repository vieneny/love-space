ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/love-space.db
JWT_SECRET=
DEV_LOGIN_ENABLED=true
ADMIN_USERNAME=admin
# Set a local administrator password. Empty means admin login stays unavailable.
ADMIN_PASSWORD=
WECHAT_APPID=
WECHAT_SECRET=
MEDIA_ROOT=data/media
MEDIA_MAX_BYTES=10485760
PUBLIC_BASE_URL=http://127.0.0.1:18100
CORS_ORIGINS=http://127.0.0.1:15173,http://localhost:15173,http://127.0.0.1:15174,http://localhost:15174
# Production: PostgreSQL 17, ENVIRONMENT=production, DEV_LOGIN_ENABLED=false,
# JWT_SECRET >=32 bytes, ADMIN_PASSWORD >=12 chars, HTTPS public endpoint.
